# No trailing slash: a worktree may leave a node_modules *symlink*, which a
# directory-only pattern does not match, and it was committed once already.
node_modules
dist/
data/
*.sqlite
*.sqlite-shm
*.sqlite-wal
.DS_Store

# Machine-local Claude Code settings; shared settings belong in .claude/settings.json
.claude/settings.local.json

# Agent worktrees created by Claude Code; never part of the project history
.claude/worktrees/

# Machine-local settings; holds the parent admin secret
.env.local
